/* ==========================================================================
   AI IT Troubleshooting Assistant - Global Stylesheet (QSS)
   ========================================================================== */

/* Global Reset & Typography */
QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #1e293b;
    background-color: transparent;
}

/* Main Window & Core Layout */
QMainWindow {
    background-color: #f8fafc;
}

/* Sidebar Styles */
#sidebarWidget {
    background-color: #0f172a;
    border-right: 1px solid #1e293b;
}

#sidebarHeader {
    padding: 18px 14px;
    border-bottom: 1px solid #1e293b;
}

#appLogoTitle {
    font-size: 15px;
    font-weight: 700;
    color: #f8fafc;
}

#appLogoSubtitle {
    font-size: 11px;
    font-weight: 500;
    color: #38bdf8;
    margin-top: 2px;
}

/* Sidebar Navigation Buttons */
QPushButton.sidebarNavBtn {
    text-align: left;
    padding: 10px 14px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
    font-weight: 500;
    color: #94a3b8;
    background-color: transparent;
    margin: 3px 10px;
}

QPushButton.sidebarNavBtn:hover {
    color: #f8fafc;
    background-color: #1e293b;
}

QPushButton.sidebarNavBtn:checked, QPushButton.sidebarNavBtn[active="true"] {
    color: #ffffff;
    background-color: #2563eb;
    font-weight: 600;
}

/* Sidebar Bottom Status */
#sidebarStatusCard {
    background-color: #1e293b;
    border-radius: 8px;
    padding: 10px;
    margin: 12px 10px;
    border: 1px solid #334155;
}

#sidebarStatusLabel {
    font-size: 11px;
    color: #94a3b8;
}

#sidebarStatusValue {
    font-size: 12px;
    font-weight: 600;
    color: #38bdf8;
}

/* Main Content Area */
#contentArea {
    background-color: #f8fafc;
    padding: 0px;
}

/* Headings */
QLabel.screenTitle {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
}

QLabel.screenSubtitle {
    font-size: 13px;
    color: #64748b;
    margin-bottom: 12px;
}

QLabel.sectionHeading {
    font-size: 16px;
    font-weight: 600;
    color: #1e293b;
    margin-top: 8px;
    margin-bottom: 4px;
}

/* Card Containers */
QFrame.cardFrame, QWidget.cardWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px;
}

/* Dashboard Action Cards */
QPushButton.actionCardBtn {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 16px;
    text-align: left;
}

QPushButton.actionCardBtn:hover {
    border-color: #3b82f6;
    background-color: #f8fafc;
}

/* Stat Metric Cards */
QFrame.statCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
}

QLabel.statValue {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
}

QLabel.statLabel {
    font-size: 12px;
    font-weight: 500;
    color: #64748b;
}

/* Buttons */
QPushButton.primaryBtn {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 6px;
    border: none;
}

QPushButton.primaryBtn:hover {
    background-color: #1d4ed8;
}

QPushButton.primaryBtn:pressed {
    background-color: #1e40af;
}

QPushButton.primaryBtn:disabled {
    background-color: #94a3b8;
    color: #f1f5f9;
}

QPushButton.secondaryBtn {
    background-color: #ffffff;
    color: #334155;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
}

QPushButton.secondaryBtn:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}

QPushButton.secondaryBtn:pressed {
    background-color: #e2e8f0;
}

QPushButton.dangerBtn {
    background-color: #ef4444;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
}

QPushButton.dangerBtn:hover {
    background-color: #dc2626;
}

QPushButton.successBtn {
    background-color: #10b981;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
}

QPushButton.successBtn:hover {
    background-color: #059669;
}

/* Input Fields & Dropdowns */
QLineEdit, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    color: #0f172a;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #2563eb;
    background-color: #ffffff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    selection-background-color: #e0e7ff;
    selection-color: #1e1b4b;
    padding: 4px;
}

/* Tables */
QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    gridline-color: #f1f5f9;
    selection-background-color: #eff6ff;
    selection-color: #1e293b;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #f1f5f9;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #f1f5f9;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 4px;
    min-width: 24px;
}

/* Badges */
QLabel.badge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 12px;
}

QLabel.badge-low {
    background-color: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
}

QLabel.badge-medium {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
}

QLabel.badge-high {
    background-color: #ffedd5;
    color: #9a3412;
    border: 1px solid #fed7aa;
}

QLabel.badge-critical {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
}

QLabel.badge-unresolved {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
}

QLabel.badge-in-progress {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
}

QLabel.badge-solved {
    background-color: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
}

QLabel.badge-neutral {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
}

/* Banner Notices */
QFrame.bannerWarning {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 6px;
    padding: 10px 14px;
}

QFrame.bannerInfo {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 10px 14px;
}

QFrame.bannerDemo {
    background-color: #f3e8ff;
    border: 1px solid #d8b4fe;
    border-radius: 6px;
    padding: 10px 14px;
}
