# ==============================================================================
# AI IT Troubleshooting Assistant - Environment Configuration
# Copy this file to '.env' and fill in your API credentials.
# ==============================================================================

# Primary AI Provider: "gemini" or "demo"
AI_PROVIDER=gemini

# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini Model Name (Default)
GEMINI_MODEL=gemini-3.8-flash

# Request Timeout (seconds)
AI_TIMEOUT_SECONDS=60

# Max file size accepted for log uploads (bytes, default 1 MB = 1048576)
MAX_LOG_SIZE_BYTES=1048576

# Max characters sent to AI (truncates head/tail if larger, default 16000)
MAX_LOG_CHARS_FOR_AI=16000

# Optional custom SQLite database path (default persists in user data directory)
# DB_PATH=C:/custom/path/troubleshooting.db
